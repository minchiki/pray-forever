<?xml version="1.0" encoding="utf-8"?>
<!-- Настройки переносятся в облачную копию; эталонные фото — только при переносе на новое устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="references/" />
    </device-transfer>
</data-extraction-rules>
