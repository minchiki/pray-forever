# Пример локальных переменных. Скопируйте в .env (он в .gitignore) и заполните.
# Само приложение секретов не использует: всё распознавание на устройстве, сервера нет.
# Эти переменные нужны только для сборки и публикации.

# --- Подпись релизной Android-сборки (android/app/build.gradle.kts) ---
# Без них release собирается неподписанным.
ANDROID_KEYSTORE_PATH=/absolute/path/to/release.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=prayer
ANDROID_KEY_PASSWORD=

# --- Публикация анонса в Telegram (scripts/post_telegram.sh) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
